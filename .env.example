# Groq API Configuration (Free, Generous Quota!)
# Get your free API key at: https://console.groq.com/

# Groq API Key (REQUIRED for AI responses)
# 1. Sign up at https://console.groq.com/
# 2. Create an API key in the dashboard
# 3. Paste it here
GROQ_API_KEY=your_groq_api_key_here

# Optional: Keep Gemini key for fallback (deprecated, but kept for compatibility)
GEMINI_API_KEY=MY_GEMINI_API_KEY
Gemini_API_Key_2=MY_GEMINI_API_KEY

# Groq Model Selection (optional - defaults to mixtral-8x7b-32768)
# Available models:
# - mixtral-8x7b-32768 (recommended, fastest)
# - llama-2-70b-chat
# - llama2-13b-chat
GROQ_MODEL=mixtral-8x7b-32768
